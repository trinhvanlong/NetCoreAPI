@model DemoMVC.Models.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="container crud-page">
    <div class="row justify-content-center"><div class="col-lg-5 col-md-8">
        <h2>Đăng nhập</h2>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3"><label asp-for="UserNameOrEmail" class="form-label"></label><input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" /><span asp-validation-for="UserNameOrEmail" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            <div class="d-flex justify-content-between mt-3"><a asp-action="ForgotPassword">Quên mật khẩu</a><a asp-action="Register">Đăng ký tài khoản</a></div>
        </form>
    </div></div>
</div>
