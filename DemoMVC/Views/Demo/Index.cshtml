@{
    ViewData["Title"] = "Thông tin hệ thống";
}

<div class="container crud-page">
    <div class="page-intro">
        <span class="page-eyebrow">NỀN TẢNG</span>
        <h2>Thông tin hệ thống</h2>
        <p>Các công nghệ đang được cấu hình trong DemoMVC.</p>
    </div>

    <div class="technology-grid system-technology-grid">
        <article class="technology-card">
            <span class="technology-mark mark-mvc">MVC</span>
            <div>
                <h3>ASP.NET Core MVC</h3>
                <p>Giao diện Razor Views được phục vụ qua mô hình MVC.</p>
            </div>
        </article>
        <article class="technology-card">
            <span class="technology-mark mark-ef">EF</span>
            <div>
                <h3>Entity Framework Core</h3>
                <p>Quản lý truy vấn và ánh xạ dữ liệu ứng dụng.</p>
            </div>
        </article>
        <article class="technology-card">
            <span class="technology-mark mark-sql">SQL</span>
            <div>
                <h3>SQL Server</h3>
                <p>Nhà cung cấp cơ sở dữ liệu được khai báo trong ứng dụng.</p>
            </div>
        </article>
    </div>
</div>
