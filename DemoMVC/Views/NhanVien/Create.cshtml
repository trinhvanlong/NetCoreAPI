@model DemoMVC.Models.NhanVien
@{
    ViewData["Title"] = "Thêm nhân viên";
}
<div class="container mt-4 mb-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
        <h2 class="text-primary fw-bold mt-3">Thêm nhân viên mới</h2>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white py-3"><h5 class="mb-0"><i class="bi bi-person-plus-fill"></i> Thông tin nhân viên</h5></div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="HoTen" class="form-label fw-semibold"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label fw-semibold"></label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="PhongBan" class="form-label fw-semibold"></label><input asp-for="PhongBan" class="form-control" /><span asp-validation-for="PhongBan" class="text-danger"></span></div>
                </div>
                <div class="alert alert-info mt-4 mb-0"><i class="bi bi-info-circle-fill"></i> Mã nhân viên sẽ được hệ thống tự động tạo theo định dạng <strong>NV00000001</strong>.</div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Lưu nhân viên</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
