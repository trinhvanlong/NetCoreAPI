@model DemoMVC.Models.NhanVien
@{ ViewData["Title"] = "Xóa nhân viên"; }
<div class="container mt-4 mb-5">
    <div class="card border-0 shadow-sm border-start border-danger border-4">
        <div class="card-header bg-white py-3"><h4 class="text-danger mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Xác nhận xóa nhân viên</h4></div>
        <div class="card-body">
            <p>Bạn có chắc muốn xóa nhân viên này?</p>
            <dl class="row mb-0">
                <dt class="col-md-3">Mã nhân viên</dt><dd class="col-md-9">@Model.MaNhanVien</dd>
                <dt class="col-md-3">Họ và tên</dt><dd class="col-md-9">@Model.HoTen</dd>
                <dt class="col-md-3">Phòng ban</dt><dd class="col-md-9">@Model.PhongBan</dd>
            </dl>
        </div>
        <div class="card-footer bg-white">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </form>
        </div>
    </div>
</div>
