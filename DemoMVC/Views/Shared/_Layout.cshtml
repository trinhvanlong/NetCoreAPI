@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isDashboard = currentController == "Home" && currentAction == "Index";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>@ViewData["Title"] - DemoMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isDashboard)
    {
        <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/crud.css" asp-append-version="true" />
    }
</head>
<body>
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="icon-dashboard" viewBox="0 0 24 24">
            <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
            <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
            <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
            <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
        </symbol>
        <symbol id="icon-student" viewBox="0 0 24 24">
            <path d="m2.5 9 9.5-5 9.5 5-9.5 5-9.5-5Z" />
            <path d="M6.5 11.2v5.1c3.5 2.7 7.5 2.7 11 0v-5.1M21.5 9v6" />
        </symbol>
        <symbol id="icon-users" viewBox="0 0 24 24">
            <path d="M16 20v-1.6a3.4 3.4 0 0 0-3.4-3.4H6.4A3.4 3.4 0 0 0 3 18.4V20" />
            <circle cx="9.5" cy="7.5" r="3.5" />
            <path d="M16 4.3a3.5 3.5 0 0 1 0 6.8M17 15h.6a3.4 3.4 0 0 1 3.4 3.4V20" />
        </symbol>
        <symbol id="icon-plus" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14" />
        </symbol>
        <symbol id="icon-list" viewBox="0 0 24 24">
            <path d="M9 6h11M9 12h11M9 18h11" />
            <circle cx="4.5" cy="6" r=".7" />
            <circle cx="4.5" cy="12" r=".7" />
            <circle cx="4.5" cy="18" r=".7" />
        </symbol>
        <symbol id="icon-code" viewBox="0 0 24 24">
            <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" />
        </symbol>
        <symbol id="icon-bell" viewBox="0 0 24 24">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
        </symbol>
        <symbol id="icon-chevron" viewBox="0 0 24 24">
            <path d="m9 18 6-6-6-6" />
        </symbol>
        <symbol id="icon-menu" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
        </symbol>
        <symbol id="icon-database" viewBox="0 0 24 24">
            <ellipse cx="12" cy="5" rx="8" ry="3" />
            <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
        </symbol>
    </svg>

    <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
    <aside class="app-sidebar" id="appSidebar" aria-label="Điều hướng chính">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index" title="DemoMVC">
            <span class="brand-mark">D</span>
            <span class="brand-copy">
                <strong>DemoMVC</strong>
                <small>HỆ THỐNG QUẢN LÝ</small>
            </span>
        </a>

        <nav class="sidebar-nav">
            <a class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
               asp-controller="Home" asp-action="Index" title="Trang chủ"
               aria-current="@(currentController == "Home" && currentAction == "Index" ? "page" : null)">
                <svg class="nav-icon"><use href="#icon-dashboard"></use></svg>
                <span class="nav-label">Trang chủ</span>
            </a>

            <div class="nav-group">
                <div class="nav-group-title">
                    <svg class="nav-icon"><use href="#icon-student"></use></svg>
                    <span class="nav-label">QUẢN LÝ SINH VIÊN</span>
                </div>
                <a class="sidebar-link sidebar-sub-link @(currentController == "SinhVien" && currentAction != "Create" ? "active" : "")"
                   asp-controller="SinhVien" asp-action="Index" title="Danh sách sinh viên"
                   aria-current="@(currentController == "SinhVien" && currentAction != "Create" ? "page" : null)">
                    <svg class="nav-icon"><use href="#icon-list"></use></svg>
                    <span class="nav-label">Danh sách sinh viên</span>
                </a>
                <a class="sidebar-link sidebar-sub-link @(currentController == "SinhVien" && currentAction == "Create" ? "active" : "")"
                   asp-controller="SinhVien" asp-action="Index" asp-route-openCreate="true" title="Thêm sinh viên"
                   aria-current="@(currentController == "SinhVien" && currentAction == "Create" ? "page" : null)">
                    <svg class="nav-icon"><use href="#icon-plus"></use></svg>
                    <span class="nav-label">Thêm sinh viên</span>
                </a>
            </div>

            <div class="nav-group">
                <div class="nav-group-title">
                    <svg class="nav-icon"><use href="#icon-users"></use></svg>
                    <span class="nav-label">QUẢN LÝ NHÂN VIÊN</span>
                </div>
                <a class="sidebar-link sidebar-sub-link @(currentController == "NhanVien" && currentAction != "Create" ? "active" : "")"
                   asp-controller="NhanVien" asp-action="Index" title="Danh sách nhân viên"
                   aria-current="@(currentController == "NhanVien" && currentAction != "Create" ? "page" : null)">
                    <svg class="nav-icon"><use href="#icon-list"></use></svg>
                    <span class="nav-label">Danh sách nhân viên</span>
                </a>
                <a class="sidebar-link sidebar-sub-link @(currentController == "NhanVien" && currentAction == "Create" ? "active" : "")"
                   asp-controller="NhanVien" asp-action="Index" asp-route-openCreate="true" title="Thêm nhân viên"
                   aria-current="@(currentController == "NhanVien" && currentAction == "Create" ? "page" : null)">
                    <svg class="nav-icon"><use href="#icon-plus"></use></svg>
                    <span class="nav-label">Thêm nhân viên</span>
                </a>
            </div>

            <div class="nav-group nav-group-system">
                <div class="nav-group-title">
                    <span class="nav-label">HỆ THỐNG</span>
                </div>
                <a class="sidebar-link @(currentController == "Demo" ? "active" : "")"
                   asp-controller="Demo" asp-action="Index" title="Hệ thống MVC"
                   aria-current="@(currentController == "Demo" ? "page" : null)">
                    <svg class="nav-icon"><use href="#icon-code"></use></svg>
                    <span class="nav-label">Hệ thống MVC</span>
                </a>
            </div>
        </nav>

        <div class="sidebar-bottom">
            <span class="sidebar-version">ASP.NET Core MVC</span>
        </div>
    </aside>

    <div class="main-shell">
        <header class="app-topbar">
            <div class="topbar-leading">
                <button class="sidebar-toggle" type="button"
                        data-sidebar-toggle aria-controls="appSidebar"
                        aria-expanded="true" aria-label="Thu gọn thanh điều hướng">
                    <svg class="icon"><use href="#icon-menu"></use></svg>
                </button>
                <div class="topbar-heading">
                    <span class="topbar-eyebrow">KHÔNG GIAN LÀM VIỆC</span>
                    <h1>@ViewData["Title"]</h1>
                </div>
            </div>

            <div class="topbar-actions">
                <div class="dropdown">
                    <button class="topbar-icon-button" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Thông báo">
                        <svg class="icon"><use href="#icon-bell"></use></svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notification-menu">
                        <strong>Thông báo</strong>
                        <p>Tính năng thông báo chưa được cấu hình.</p>
                    </div>
                </div>

                <div class="dropdown">
                    <button class="profile-button" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="profile-avatar" aria-hidden="true">D</span>
                        <span class="profile-copy">
                            <strong>DemoMVC</strong>
                            <small>Ứng dụng quản lý</small>
                        </span>
                        <svg class="profile-chevron"><use href="#icon-chevron"></use></svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end profile-menu">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="profile-menu-note">@User.Identity.Name</div>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Thông tin cá nhân</a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                <button type="submit" class="dropdown-item">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Register">Đăng ký</a>
                        }
                        <a class="dropdown-item" asp-controller="Demo" asp-action="Index">Thông tin hệ thống</a>
                    </div>
                </div>
            </div>
        </header>

        <main class="page-content" role="main">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>© @DateTime.Now.Year DemoMVC</span>
            <span>Hệ thống quản lý dữ liệu</span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
