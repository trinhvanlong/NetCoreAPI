
@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>

        <h2 class="text-primary fw-bold mt-3">
            Thêm sinh viên mới
        </h2>

        <p class="text-secondary">
            Nhập thông tin sinh viên và lựa chọn khoa quản lý.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-person-plus-fill"></i>
                Thông tin sinh viên
            </h5>
        </div>

        <div class="card-body p-4">
            <form asp-controller="SinhVien"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-3">

                    <!-- HỌ TÊN -->
                    <div class="col-md-6">
                        <label asp-for="HoTen"
                               class="form-label fw-semibold"></label>

                        <input asp-for="HoTen"
                               class="form-control"
                               placeholder="Nhập họ và tên" />

                        <span asp-validation-for="HoTen"
                              class="text-danger"></span>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label fw-semibold"></label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="example@email.com" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <!-- SỐ ĐIỆN THOẠI -->
                    <div class="col-md-6">
                        <label asp-for="SoDienThoai"
                               class="form-label fw-semibold"></label>

                        <input asp-for="SoDienThoai"
                               type="tel"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <span asp-validation-for="SoDienThoai"
                              class="text-danger"></span>
                    </div>

                    <!-- CHỌN KHOA -->
                    <div class="col-md-6">
                        <label asp-for="KhoaId"
                               class="form-label fw-semibold"></label>

                        <select asp-for="KhoaId"
                                asp-items="ViewBag.KhoaId"
                                class="form-select">
                            <option value="">-- Chọn khoa --</option>
                        </select>

                        <span asp-validation-for="KhoaId"
                              class="text-danger"></span>
                    </div>

                    <!-- NĂM NHẬP HỌC -->
                    <div class="col-md-4">
                        <label asp-for="NamNhapHoc"
                               class="form-label fw-semibold"></label>

                        <input asp-for="NamNhapHoc"
                               type="number"
                               min="2000"
                               max="2099"
                               class="form-control" />

                        <span asp-validation-for="NamNhapHoc"
                              class="text-danger"></span>
                    </div>

                    <!-- HỆ ĐÀO TẠO -->
                    <div class="col-md-4">
                        <label asp-for="MaHeDaoTao"
                               class="form-label fw-semibold"></label>

                        <select asp-for="MaHeDaoTao"
                                class="form-select">
                            <option value="21">
                                21 - Đại học chính quy
                            </option>
                            <option value="22">
                                22 - Hệ đào tạo khác
                            </option>
                        </select>

                        <span asp-validation-for="MaHeDaoTao"
                              class="text-danger"></span>
                    </div>

                    <!-- MÃ NGÀNH: ĐÃ THÊM CÁC LỰA CHỌN -->
                    <div class="col-md-4">
                        <label asp-for="MaNganh"
                               class="form-label fw-semibold"></label>

                        <select asp-for="MaNganh"
                                class="form-select">
                            <option value="05">
                                05 - Công nghệ thông tin
                            </option>
                            <option value="06">
                                06 - Kỹ thuật phần mềm
                            </option>
                            <option value="07">
                                07 - Hệ thống thông tin
                            </option>
                            <option value="08">
                                08 - Khoa học dữ liệu
                            </option>
                            <option value="09">
                                09 - An toàn thông tin
                            </option>
                        </select>

                        <span asp-validation-for="MaNganh"
                              class="text-danger"></span>
                    </div>

                </div>

                <!-- THÔNG BÁO SINH MÃ TỰ ĐỘNG -->
                <div class="alert alert-info mt-4 mb-0">
                    <i class="bi bi-info-circle-fill"></i>

                    <strong>Mã sinh viên tự động:</strong>
                    Hệ thống sẽ tạo mã khi lưu dựa trên năm nhập học,
                    hệ đào tạo, ngành học và số thứ tự.

                    <div class="mt-2">
                        Ví dụ: <strong>2821050199</strong>
                    </div>

                    <div class="mt-2">
                        <small>
                            Khi đổi năm nhập học, hệ đào tạo hoặc mã ngành,
                            tiền tố của mã sinh viên mới sẽ thay đổi tương ứng.
                        </small>
                    </div>
                </div>

                <!-- NÚT CHỨC NĂNG -->
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-save"></i>
                        Lưu sinh viên
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle"></i>
                        Hủy
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}

