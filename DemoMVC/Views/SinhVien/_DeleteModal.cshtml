@model DemoMVC.Models.SinhVien

<form asp-controller="SinhVien" asp-action="Delete" asp-route-id="@Model.Id" method="post" data-crud-form>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="modal-header">
        <h5 class="modal-title text-danger" id="crudModalTitle">Xác nhận xóa sinh viên</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
    </div>
    <div class="modal-body">
        <p>Bạn có chắc chắn muốn xóa hồ sơ sinh viên này không?</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã sinh viên</dt><dd class="col-sm-8">@Model.MaSinhVien</dd>
            <dt class="col-sm-4">Họ và tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
            <dt class="col-sm-4">Khoa</dt><dd class="col-sm-8">@(Model.Khoa?.TenKhoa ?? "Chưa xác định")</dd>
        </dl>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-danger">
            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
            <span class="submit-label">Xác nhận xóa</span>
        </button>
    </div>
</form>
