@model DemoMVC.Models.SinhVien

<div class="modal-header">
    <h5 class="modal-title" id="crudModalTitle">Chi tiết sinh viên</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>
<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Mã sinh viên</dt><dd class="col-sm-8">@Model.MaSinhVien</dd>
        <dt class="col-sm-4">Họ và tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
        <dt class="col-sm-4">Số điện thoại</dt><dd class="col-sm-8">@Model.SoDienThoai</dd>
        <dt class="col-sm-4">Năm nhập học</dt><dd class="col-sm-8">@Model.NamNhapHoc</dd>
        <dt class="col-sm-4">Mã hệ đào tạo</dt><dd class="col-sm-8">@Model.MaHeDaoTao</dd>
        <dt class="col-sm-4">Mã ngành</dt><dd class="col-sm-8">@Model.MaNganh</dd>
        <dt class="col-sm-4">Khoa</dt><dd class="col-sm-8">@(Model.Khoa?.TenKhoa ?? "Chưa xác định")</dd>
    </dl>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
</div>
